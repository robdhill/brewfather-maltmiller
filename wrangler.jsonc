{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brewfather-mcp-worker",
  "main": "index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Enable Cloudflare Browser Rendering API (Headless Chrome)
  "browser": {
    "binding": "MYBROWSER"
  },
  // Required by @cloudflare/workers-oauth-provider to store OAuth grants,
  // tokens, and registered client metadata for the /gh-proxy/* routes.
  //
  // This namespace does not exist yet and needs to be created once before
  // deploying this branch. Easiest way without local tooling: Cloudflare
  // dashboard -> Workers & Pages -> KV -> Create namespace (call it
  // something like "brewfather-mcp-worker-oauth"), then paste its id below
  // in place of "REPLACE_WITH_KV_NAMESPACE_ID". Alternatively, from a
  // Codespace/Gitpod terminal: `wrangler kv namespace create OAUTH_KV`.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
