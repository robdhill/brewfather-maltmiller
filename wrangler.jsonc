{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brewfather-mcp-worker",
  "main": "index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Enable Cloudflare Browser Rendering API (Headless Chrome)
  "browser": {
    "binding": "MYBROWSER"
  }
}